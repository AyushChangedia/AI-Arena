# ─────────────────────────────────────────────────────────────────────────────
# AI AGENT ARENA — environment
#
# Every variable here is OPTIONAL. With none of them set the Arena runs in
# DEMO MODE: real harness, real tools, real sandbox, real grading, driven by
# deterministic scripted policies instead of a live model. The UI labels those
# matches DEMO everywhere they appear.
#
# Set a provider key to promote the identical flow to a LIVE match.
# ─────────────────────────────────────────────────────────────────────────────

# --- Model providers (server-only; never exposed to the browser) -------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional base-URL overrides (proxies, gateways, self-hosted OpenAI-compatible)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Web search --------------------------------------------------------------
# Without a key, web.search/web.fetch run against the bundled OFFLINE CORPUS
# and every result is badged as such in the UI.
TAVILY_API_KEY=

# --- Sandbox -----------------------------------------------------------------
# node:vm code execution. Enabled by default. It removes host bindings and
# enforces a hard timeout, but it is a RESTRICTION LAYER, NOT AN ISOLATION
# BOUNDARY — see docs/ARCHITECTURE.md §4.3. Set to "0" to disable code
# execution entirely; code.run then returns a clean "not available" tool error.
ARENA_ENABLE_VM_SANDBOX=1

# --- Persistence -------------------------------------------------------------
# Directory for the file-backed store. Falls back to memory-only if unwritable.
ARENA_DATA_DIR=.data

# --- Limits (defaults shown; agents may request lower, never higher) ---------
ARENA_MAX_STEPS=40
ARENA_MAX_WALL_MS=180000
ARENA_MAX_BUDGET_USD=2.00
